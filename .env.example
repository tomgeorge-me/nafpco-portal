APP_NAME="NAFPCO Public Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://www.neyyassery-agro.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# -----------------------------------------------------------------
# Database: this app reads from the SAME database as the NAFPCO ERP
# (nafpco_app). Only `inventory_items` (product catalog) is read,
# and the new `enquiries` table is written to.
#
# STRONGLY RECOMMENDED: create a dedicated MySQL user for this app
# with privileges limited to:
#   SELECT on inventory_items
#   SELECT, INSERT, UPDATE on enquiries
# so a bug or compromise in the public site can never touch sales,
# customers, users, expenses, shareholders, etc. Example:
#
#   CREATE USER 'nafpco_public'@'%' IDENTIFIED BY 'CHANGE_ME';
#   GRANT SELECT ON nafpco_app.inventory_items TO 'nafpco_public'@'%';
#   GRANT SELECT, INSERT, UPDATE ON nafpco_app.enquiries TO 'nafpco_public'@'%';
#   FLUSH PRIVILEGES;
#
# Note: sessions/cache/queue below deliberately use file & sync
# drivers, NOT `database` — the `sessions`, `cache`, and `jobs`
# tables are the same physical tables the ERP app uses. Sharing
# them (especially `jobs`, if the ERP ever runs a queue worker)
# risks one app picking up the other's queued job payloads. Using
# file/sync here also means the GRANT above doesn't need to be
# widened to cover those tables.
# -----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nafpco_app
DB_USERNAME=nafpco_public
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=file

QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@neyyassery-agro.example"
MAIL_FROM_NAME="${APP_NAME}"

# Where public "Contact / Enquiry" form submissions are emailed
ENQUIRY_NOTIFY_EMAIL=info@neyyassery-agro.example
